{
  "version": "manual_test_dp",
  "dataset": "sample_data",
  "differential_privacy": {
    "enabled": true,
    "accumulated_epsilon": 0.0,
    "accumulated_delta": 0.0,
    "column_budgets": {
      "年齡": {
        "type": "continuous",
        "epsilon_budget": 1.0,
        "delta_budget": 0.0,
        "sensitivity": 120.0,
        "minimum_unit": 5,
        "clipping_bounds": [0, 120],
        "out_of_bounds_strategy": "clamp"
      },
      "地區": {
        "type": "categorical",
        "epsilon_budget": 1.0
      }
    }
  }
}
